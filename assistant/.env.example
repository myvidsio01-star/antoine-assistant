# ─────────────────────────────────────────────
# A.N.T.O.I.N.E — Configuration des cles API
# ─────────────────────────────────────────────
# Renommez ce fichier en .env et remplissez vos cles

# OBLIGATOIRE - Cle Groq gratuite sur console.groq.com
GROQ_API_KEY=

# OPTIONNEL - Cle Gemini gratuite sur ai.google.dev
GEMINI_API_KEY=

# OPTIONNEL - Cle Anthropic sur console.anthropic.com
ANTHROPIC_API_KEY=

# OPTIONNEL - Home Assistant (domotique)
HA_URL=
HA_TOKEN=
